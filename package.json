{
  "name": "rts-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "RTS - Radio Transmission System - Application Desktop",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "build:all": "node scripts/build.js",
    "build:win": "npm run build && electron-builder --win --publish=never",
    "build:mac": "npm run build && electron-builder --mac --publish=never",
    "build:linux": "npm run build && electron-builder --linux --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=always",
    "dist:mac": "npm run build && electron-builder --mac --publish=always",
    "dist:linux": "npm run build && electron-builder --linux --publish=always",
    "postinstall": "electron-builder install-app-deps",
    "debug:build": "cross-env DEBUG=true npm run build && electron-builder --win --publish=never",
    "debug:electron": "cross-env DEBUG=true electron .",
    "test:build": "node scripts/test-build.js",
    "test:quick": "node scripts/quick-test.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "test:pdf": "node scripts/test-pdf-simple.js",
    "test:puppeteer": "node scripts/test-puppeteer-pdf.js",
    "test:complete": "node scripts/test-complete-pdf.js"
  },
  "build": {
    "appId": "com.rts.desktop",
    "productName": "RTS - Radio Transmission System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/",
        "to": "public/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/vite.svg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/vite.svg",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.11",
    "chart.js": "^4.5.0",
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.294.0",
    "puppeteer": "^24.11.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.0.0",
    "three": "^0.158.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "terser": "^5.43.1",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "rts",
    "radio",
    "transmission",
    "system",
    "electron",
    "desktop",
    "react",
    "typescript"
  ],
  "author": "RTS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rts-team/rts-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/rts-team/rts-desktop/issues"
  }
}
